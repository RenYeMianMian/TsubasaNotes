<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 缩放到安全区：108dp 图层中仅中央 72dp 可见，内容须落在 66dp 安全圆内 -->
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:pivotX="54"
        android:pivotY="54">

    <!-- 左耳：整只黑色 -->
    <path
        android:pathData="M30 41 L33 19 L52 33 Z"
        android:fillColor="#141414"
        android:strokeColor="#141414"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round" />

    <!-- 右耳：白色 + 黑描边，耳尖染黑 -->
    <path
        android:pathData="M78 41 L75 19 L56 33 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#141414"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round" />
    <group>
        <!-- 裁切范围必须是 <clip-path> 子元素：VectorDrawable 没有 android:clip-path 这个属性，
             写成 group 的属性会被 AAPT2 拒绝（attribute android:clip-path not found）。 -->
        <clip-path android:pathData="M78 41 L75 19 L56 33 Z" />
        <path
            android:pathData="M56 30 C63 23 71 17 79 12 L82 28 C73 30 64 30 56 30 Z"
            android:fillColor="#141414" />
    </group>

    <!-- 脸：白色色块 + 黑描边 -->
    <path
        android:pathData="M26 62 C26 47 30 39 35 36 C41 32 47 31 54 31 C61 31 67 32 73 36 C78 39 82 47 82 62 C82 79 70 89 54 89 C38 89 26 79 26 62 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#141414"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round" />

    <!-- 黑色斑块（裁切在脸内） -->
    <group>
        <!-- 同上：裁切范围用 <clip-path> 子元素表达 -->
        <clip-path android:pathData="M26 62 C26 47 30 39 35 36 C41 32 47 31 54 31 C61 31 67 32 73 36 C78 39 82 47 82 62 C82 79 70 89 54 89 C38 89 26 79 26 62 Z" />
        <path
            android:pathData="M20 40 C24 31 34 26 46 26 C57 26 65 31 64 38 C63 45 54 48 45 48 C36 48 28 52 25 59 C22 64 18 46 20 40 Z"
            android:fillColor="#141414" />
        <path
            android:pathData="M28 79 C33 75 40 78 40 84 C40 90 32 92 27 89 C23 86 24 82 28 79 Z"
            android:fillColor="#141414" />
        <path
            android:pathData="M67 76 C71 69 80 68 84 74 C88 81 84 88 76 89 C69 90 63 83 67 76 Z"
            android:fillColor="#141414" />
    </group>

    <!-- 眼睛 -->
    <path
        android:pathData="M30.5 60 a6.5,7 0 1,0 13,0 a6.5,7 0 1,0 -13,0 Z"
        android:fillColor="#141414" />
    <path
        android:pathData="M64.5 60 a6.5,7 0 1,0 13,0 a6.5,7 0 1,0 -13,0 Z"
        android:fillColor="#141414" />

    <!-- 鼻子 -->
    <path
        android:pathData="M50 70 L58 70 L54 75 Z"
        android:fillColor="#141414" />

    <!-- 嘴 -->
    <path
        android:pathData="M54 75 C54 79 50.5 80.5 48 79"
        android:strokeColor="#141414"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54 75 C54 79 57.5 80.5 60 79"
        android:strokeColor="#141414"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- 胡须 -->
    <path
        android:pathData="M34 64 L28 61"
        android:strokeColor="#141414"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M33 71 L27 71"
        android:strokeColor="#141414"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M74 64 L80 61"
        android:strokeColor="#141414"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M75 71 L81 71"
        android:strokeColor="#141414"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    </group>
</vector>
